<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách bài viết</title>
    <link rel="stylesheet" href="/css/style.css"> 
</head>
<body>
    <h1>Danh sách bài viết</h1>
    <nav>
        <a href="/">Trang chủ</a>
        <a href="/news">Tin tức</a>
        
        <% if (user) { %> 
            <a href="/news/add">Thêm bài viết</a> 
            <span>Xin chào, <%= user.username %></span> 
            <a href="/logout">Đăng xuất</a> 
        <% } else { %> 
            <a href="/login">Đăng nhập</a> 
        <% } %>
    </nav>

    <ul>
        <% posts.forEach(post => { %>
            <li>
                <h3>
                    <a href="/news/<%= post.id %>">
                        <%= post.title %>   
                    </a>

                    <% if (user) { %> 
                        <a href="/news/<%= post.id %>/edit">Sửa</a> 

                        <form action="/news/<%= post.id %>/delete" method="POST" style="display:inline;"> 
                            <button type="submit">Xóa</button> 
                        </form> 
                    <% } %>
                </h3>
            </li>
        <% }) %>    
    </ul>
</body>
</html>